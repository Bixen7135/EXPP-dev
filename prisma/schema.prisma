generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountDomain {
  GLOBAL
  ORGANIZATION
}

enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
  SINGLE_THEME
}

enum LightThemePreset {
  DEFAULT
  COLORBLIND
  TRITANOPIA
}

enum DarkThemePreset {
  DEFAULT
  DIMMED
  COLORBLIND
  TRITANOPIA
}

enum SingleThemeChoice {
  LIGHT_DEFAULT
  LIGHT_COLORBLIND
  LIGHT_TRITANOPIA
  DARK_DEFAULT
  DARK_COLORBLIND
  DARK_TRITANOPIA
  DARK_SOFT
}

enum EnvironmentType {
  PERSONAL
  ORGANIZATION
}

enum RoleScope {
  ORGANIZATION
  INSTITUTION
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  TRAINING_CENTER
  OTHER
}

enum OnboardingMethod {
  INVITE
  MANUAL
  BULK
}

enum FormalEntityKind {
  CLASS
  SUBJECT_GROUP
  SUBGROUP
  STREAM
  COHORT
  COURSE
  MODULE
  OTHER
}

enum RoleAssignmentSource {
  SYSTEM
  CUSTOM
}

enum MaterialStatus {
  PROCESSING
  READY
  ERROR
}

enum MaterialIndexStatus {
  PENDING
  INDEXING
  READY
  ERROR
}

enum GenerationStatus {
  QUEUED
  PENDING
  PLANNING
  RETRIEVING
  GENERATING
  VALIDATING
  READY
  ERROR
  CANCELLED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHABLE
  ASSIGNED
}

enum AiHelpMode {
  NO_HELP
  CLARIFICATION
  GUIDED
  POST_ASSESSMENT
}

enum DistributionStatus {
  MANDATORY
  PRACTICE
}

enum RecipientStatus {
  PENDING
  ACTIVE
  SUBMITTED
}

enum RecipientSourceType {
  FORMAL_ENTITY
  TARGET_GROUP
  PRACTICE_GROUP
  USER @map("ACCOUNT")
}

enum AttemptStatus {
  DRAFT
  SUBMITTED
}

enum HelpRequestStatus {
  ALLOWED
  BLOCKED
}

enum AssessmentStatus {
  PENDING
  AUTO_CHECKED
  REVIEWED
  PUBLISHED
}

enum AutoCheckStatus {
  NOT_STARTED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum AssessmentAiRunTrigger {
  AUTO_ON_SUBMIT
  MANUAL_RERUN
}

enum AssessmentAiRunStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum StudentAnalyticsInsightStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
  STALE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts    Account[]
  auditEvents AuditEvent[] @relation("ActorUserAudit")
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model Account {
  id             String        @id @default(cuid())
  userId         String        @unique
  domain         AccountDomain
  environment    EnvironmentType @default(PERSONAL)
  displayName    String
  avatarUrl      String?
  slug           String?
  organizationId String?
  themeMode      ThemeMode         @default(SYSTEM)
  lightThemePreset LightThemePreset @default(DEFAULT)
  darkThemePreset DarkThemePreset   @default(DEFAULT)
  singleThemeChoice SingleThemeChoice @default(DARK_DEFAULT)
  contrastEnabled Boolean           @default(false)
  contrastLightEnabled Boolean      @default(false)
  contrastDarkEnabled Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  activeSessions            Session[]               @relation("ActiveUserSessions")
  memberships               AccountMembership[]
  roleAssignments           RoleAssignment[]
  materials                 Material[]              @relation("MaterialOwner")
  materialChunks            MaterialChunk[]
  knowledgeConcepts         KnowledgeConcept[]
  knowledgeRelations        KnowledgeRelation[]
  materialFolders           MaterialFolder[]        @relation("MaterialFolderOwner")
  externalSourceProfiles    ExternalSourceProfile[]
  generationRequests        GenerationRequest[]     @relation("GenerationRequestOwner")
  assignments               Assignment[]            @relation("AssignmentOwner")
  assignmentVersionsAuthored AssignmentVersion[]    @relation("AssignmentVersionAuthor")
  distributionsCreated      AssignmentDistribution[] @relation("CreatorDistributions")
  recipientRecords          AssignmentRecipient[]   @relation("RecipientAccounts")
  attempts                  Attempt[]               @relation("LearnerAttempts")
  helpRequests              HelpRequest[]           @relation("LearnerHelpRequests")
  assessmentsReviewed       Assessment[]            @relation("ReviewerAssessments")
  taskBankItems             TaskBankItem[]          @relation("TaskBankOwner")
  learnerAnalyticsInsights  StudentAnalyticsInsight[] @relation("LearnerAnalyticsInsights")
  teacherAnalyticsInsights  StudentAnalyticsInsight[] @relation("TeacherAnalyticsInsights")

  formalMemberships   FormalEntityMember[]
  targetMemberships   TargetGroupMember[]
  practiceMemberships PracticeGroupMember[]

  auditEvents AuditEvent[] @relation("ActorAccountAudit")

  @@index([organizationId])
  @@index([domain, organizationId])
  @@unique([organizationId, slug])
  @@map("accounts")
}

model Session {
  id                    String   @id @default(cuid())
  activeUserContextId   String?  @map("activeAccountId")
  signedInUserContextIds String[] @default([]) @map("signedInAccountIds")
  token                 String   @unique
  ipAddress             String?
  userAgent             String?
  countryCode           String?
  country               String?
  region                String?
  city                  String?
  latitude              Float?
  longitude             Float?
  lastSeenAt            DateTime @default(now())
  expiresAt             DateTime
  createdAt             DateTime @default(now())

  activeUserContext Account? @relation("ActiveUserSessions", fields: [activeUserContextId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([activeUserContextId])
  @@index([lastSeenAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("email_verification_tokens")
}

model Organization {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  onboardingPolicy Json?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accounts           Account[]
  institutions       Institution[]
  memberships        AccountMembership[]
  roles              RoleDefinition[]
  roleAssignments    RoleAssignment[]
  materials          Material[]
  generationRequests GenerationRequest[]
  assignments        Assignment[]
  distributions      AssignmentDistribution[]
  auditEvents        AuditEvent[]

  @@map("organizations")
}

model Institution {
  id                       String          @id @default(cuid())
  organizationId           String
  slug                     String
  name                     String
  type                     InstitutionType
  onboardingPolicyOverride Json?
  isActive                 Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships        AccountMembership[]
  roles              RoleDefinition[]
  roleAssignments    RoleAssignment[]
  formalEntities     FormalEntity[]
  targetGroups       TargetGroup[]
  practiceGroups     PracticeGroup[]
  materials          Material[]
  generationRequests GenerationRequest[]
  assignments        Assignment[]
  distributions      AssignmentDistribution[]
  auditEvents        AuditEvent[]

  @@index([organizationId])
  @@unique([organizationId, slug])
  @@map("institutions")
}

model AccountMembership {
  id             String           @id @default(cuid())
  accountId      String
  organizationId String
  institutionId  String?
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([organizationId])
  @@index([institutionId])
  @@unique([accountId, organizationId, institutionId])
  @@map("account_memberships")
}

model RoleDefinition {
  id              String               @id @default(cuid())
  scope           RoleScope
  source          RoleAssignmentSource @default(SYSTEM)
  organizationId  String?
  institutionId   String?
  institutionType InstitutionType?
  key             String
  name            String
  description     String?
  permissions     Json
  isSystem        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution  Institution?  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assignments  RoleAssignment[]

  @@index([scope])
  @@index([organizationId])
  @@index([institutionId])
  @@unique([scope, organizationId, institutionId, key])
  @@map("role_definitions")
}

model RoleAssignment {
  id             String   @id @default(cuid())
  accountId      String
  roleId         String
  organizationId String?
  institutionId  String?
  createdAt      DateTime @default(now())

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  institution  Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([roleId])
  @@index([organizationId])
  @@index([institutionId])
  @@unique([accountId, roleId, organizationId, institutionId])
  @@map("role_assignments")
}

model FormalEntity {
  id            String          @id @default(cuid())
  institutionId String
  kind          FormalEntityKind
  customKind    String?
  name          String
  code          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  institution  Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  members      FormalEntityMember[]
  materials    Material[]
  distributions AssignmentDistribution[] @relation("FormalEntityDistributions")

  @@index([institutionId])
  @@index([kind])
  @@map("formal_entities")
}

model FormalEntityMember {
  id             String   @id @default(cuid())
  formalEntityId String
  accountId      String
  memberRole     String?
  createdAt      DateTime @default(now())

  formalEntity FormalEntity @relation(fields: [formalEntityId], references: [id], onDelete: Cascade)
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([formalEntityId])
  @@index([accountId])
  @@unique([formalEntityId, accountId])
  @@map("formal_entity_members")
}

model TargetGroup {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  purpose       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution  Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  members      TargetGroupMember[]
  materials    Material[]
  distributions AssignmentDistribution[] @relation("TargetGroupDistributions")

  @@index([institutionId])
  @@map("target_groups")
}

model TargetGroupMember {
  id            String   @id @default(cuid())
  targetGroupId String
  accountId     String
  memberRole    String?
  createdAt     DateTime @default(now())

  targetGroup TargetGroup @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([targetGroupId])
  @@index([accountId])
  @@unique([targetGroupId, accountId])
  @@map("target_group_members")
}

model PracticeGroup {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  purpose       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution  Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  members      PracticeGroupMember[]
  materials    Material[]
  distributions AssignmentDistribution[] @relation("PracticeGroupDistributions")

  @@index([institutionId])
  @@map("practice_groups")
}

model PracticeGroupMember {
  id              String   @id @default(cuid())
  practiceGroupId String
  accountId       String
  memberRole      String?
  createdAt       DateTime @default(now())

  practiceGroup PracticeGroup @relation(fields: [practiceGroupId], references: [id], onDelete: Cascade)
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([practiceGroupId])
  @@index([accountId])
  @@unique([practiceGroupId, accountId])
  @@map("practice_group_members")
}

model AuditEvent {
  id             String   @id @default(cuid())
  userId         String?
  actorAccountId String?
  organizationId String?
  institutionId  String?
  action         String
  entityType     String?
  entityId       String?
  context        Json?
  traceId        String
  createdAt      DateTime @default(now())

  user         User?         @relation("ActorUserAudit", fields: [userId], references: [id], onDelete: SetNull)
  actorAccount Account?      @relation("ActorAccountAudit", fields: [actorAccountId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  institution  Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actorAccountId])
  @@index([organizationId])
  @@index([institutionId])
  @@index([traceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

model Material {
  id               String         @id @default(cuid())
  ownerAccountId   String
  organizationId   String?
  institutionId    String?
  formalEntityId   String?
  targetGroupId    String?
  practiceGroupId  String?
  folderId         String?
  title            String
  originalFilename String
  mimeType         String
  fileSize         Int
  storagePath      String
  extractedText    String?
  status           MaterialStatus @default(PROCESSING)
  indexStatus      MaterialIndexStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  ownerAccount Account        @relation("MaterialOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  institution Institution?    @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  formalEntity FormalEntity?  @relation(fields: [formalEntityId], references: [id], onDelete: SetNull)
  targetGroup  TargetGroup?   @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  practiceGroup PracticeGroup? @relation(fields: [practiceGroupId], references: [id], onDelete: SetNull)
  folder       MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags         MaterialTag[]
  chunks       MaterialChunk[]
  concepts     KnowledgeConcept[]
  relations    KnowledgeRelation[]

  @@index([ownerAccountId])
  @@index([organizationId])
  @@index([institutionId])
  @@index([formalEntityId])
  @@index([targetGroupId])
  @@index([practiceGroupId])
  @@index([folderId])
  @@index([indexStatus])
  @@map("materials")
}

model MaterialFolder {
  id             String   @id @default(cuid())
  ownerAccountId String
  name           String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerAccount Account          @relation("MaterialFolderOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  parent       MaterialFolder?  @relation("MaterialFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     MaterialFolder[] @relation("MaterialFolderTree")
  materials    Material[]

  @@index([ownerAccountId])
  @@index([parentId])
  @@index([ownerAccountId, parentId])
  @@map("material_folders")
}

model MaterialTag {
  id         String @id @default(cuid())
  materialId String
  key        String
  value      String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@map("material_tags")
}

model MaterialChunk {
  id             String   @id @default(cuid())
  materialId     String
  ownerAccountId String
  chunkIndex     Int
  text           String
  startOffset    Int
  endOffset      Int
  embedding      Json?
  keywords       String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  material     Material              @relation(fields: [materialId], references: [id], onDelete: Cascade)
  ownerAccount Account               @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  conceptLinks MaterialChunkConcept[]

  @@index([materialId])
  @@index([ownerAccountId])
  @@index([materialId, chunkIndex])
  @@map("material_chunks")
}

model KnowledgeConcept {
  id             String   @id @default(cuid())
  ownerAccountId String
  materialId     String?
  name           String
  normalizedName String
  weight         Float    @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerAccount      Account                @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  material          Material?              @relation(fields: [materialId], references: [id], onDelete: Cascade)
  outgoingRelations KnowledgeRelation[]    @relation("KnowledgeRelationFrom")
  incomingRelations KnowledgeRelation[]    @relation("KnowledgeRelationTo")
  chunkLinks        MaterialChunkConcept[]

  @@index([ownerAccountId])
  @@index([materialId])
  @@index([ownerAccountId, normalizedName])
  @@map("knowledge_concepts")
}

model KnowledgeRelation {
  id             String   @id @default(cuid())
  ownerAccountId String
  materialId     String?
  fromConceptId  String
  toConceptId    String
  relationType   String
  weight         Float    @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerAccount Account          @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  material     Material?        @relation(fields: [materialId], references: [id], onDelete: Cascade)
  fromConcept  KnowledgeConcept @relation("KnowledgeRelationFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  toConcept    KnowledgeConcept @relation("KnowledgeRelationTo", fields: [toConceptId], references: [id], onDelete: Cascade)

  @@index([ownerAccountId])
  @@index([materialId])
  @@index([fromConceptId])
  @@index([toConceptId])
  @@map("knowledge_relations")
}

model MaterialChunkConcept {
  id        String   @id @default(cuid())
  chunkId   String
  conceptId String
  score     Float    @default(1)
  createdAt DateTime @default(now())

  chunk   MaterialChunk    @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  concept KnowledgeConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([chunkId, conceptId])
  @@index([conceptId])
  @@map("material_chunk_concepts")
}

model ExternalSourceProfile {
  id               String   @id @default(cuid())
  ownerAccountId   String
  name             String
  includeWhitelist Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownerAccount      Account                    @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  urls              ExternalSourceProfileUrl[]
  generationRequests GenerationRequest[]

  @@index([ownerAccountId])
  @@map("external_source_profiles")
}

model ExternalSourceProfileUrl {
  id        String   @id @default(cuid())
  profileId String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile ExternalSourceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@unique([profileId, url])
  @@map("external_source_profile_urls")
}

model GenerationRequest {
  id             String           @id @default(cuid())
  ownerAccountId String
  organizationId String?
  institutionId  String?
  externalSourceProfileId String?
  status         GenerationStatus @default(QUEUED)
  constraints    Json
  materialIds    String[]
  runToken       Int              @default(1)
  metadata       Json?
  cancelRequestedAt DateTime?
  cancelReason   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  ownerAccount Account          @relation("GenerationRequestOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  institution Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  externalSourceProfile ExternalSourceProfile? @relation(fields: [externalSourceProfileId], references: [id], onDelete: SetNull)
  plan         GenerationPlan?
  result       GenerationResult?

  @@index([ownerAccountId])
  @@index([organizationId])
  @@index([institutionId])
  @@index([externalSourceProfileId])
  @@map("generation_requests")
}

model GenerationPlan {
  id        String   @id @default(cuid())
  requestId String   @unique
  outline   Json
  createdAt DateTime @default(now())

  request GenerationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("generation_plans")
}

model GenerationResult {
  id        String   @id @default(cuid())
  requestId String   @unique
  content   Json
  format    String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request     GenerationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@map("generation_results")
}

model Assignment {
  id                 String           @id @default(cuid())
  ownerAccountId     String
  organizationId     String?
  institutionId      String?
  generationResultId String?
  title              String
  content            Json
  status             AssignmentStatus @default(DRAFT)
  currentVersionId   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  ownerAccount    Account            @relation("AssignmentOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  organization    Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  institution     Institution?       @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  generationResult GenerationResult? @relation(fields: [generationResultId], references: [id], onDelete: SetNull)
  versions        AssignmentVersion[]
  items           AssignmentItem[]
  tags            AssignmentTag[]
  distributions   AssignmentDistribution[]

  @@index([ownerAccountId])
  @@index([organizationId])
  @@index([institutionId])
  @@map("assignments")
}

model AssignmentVersion {
  id                String   @id @default(cuid())
  assignmentId      String
  versionNumber     Int
  content           Json
  authorAccountId   String
  changeDescription String?
  createdAt         DateTime @default(now())

  assignment    Assignment                @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  authorAccount Account                   @relation("AssignmentVersionAuthor", fields: [authorAccountId], references: [id], onDelete: Cascade)
  distributions AssignmentDistribution[]

  @@index([assignmentId])
  @@index([authorAccountId])
  @@map("assignment_versions")
}

model AssignmentItem {
  id             String @id @default(cuid())
  assignmentId   String
  order          Int
  type           String
  question       Json
  expectedAnswer Json

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_items")
}

model AssignmentTag {
  id           String @id @default(cuid())
  assignmentId String
  key          String
  value        String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([key, value])
  @@map("assignment_tags")
}

model TaskBankItem {
  id             String   @id @default(cuid())
  ownerAccountId String
  title          String
  content        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerAccount Account       @relation("TaskBankOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  tags         TaskBankTag[]

  @@index([ownerAccountId])
  @@map("task_bank_items")
}

model TaskBankTag {
  id             String @id @default(cuid())
  taskBankItemId String
  key            String
  value          String

  taskBankItem TaskBankItem @relation(fields: [taskBankItemId], references: [id], onDelete: Cascade)

  @@index([taskBankItemId])
  @@index([key, value])
  @@map("task_bank_tags")
}

model AssignmentDistribution {
  id              String             @id @default(cuid())
  assignmentId    String
  versionId       String
  creatorAccountId String
  organizationId  String?
  institutionId   String?
  formalEntityId  String?
  targetGroupId   String?
  practiceGroupId String?
  deadline        DateTime?
  status          DistributionStatus @default(MANDATORY)
  isGraded        Boolean            @default(true)
  aiHelpMode      AiHelpMode         @default(NO_HELP)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  version       AssignmentVersion @relation(fields: [versionId], references: [id])
  creatorAccount Account          @relation("CreatorDistributions", fields: [creatorAccountId], references: [id], onDelete: Cascade)
  organization  Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  institution   Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  formalEntity  FormalEntity?     @relation("FormalEntityDistributions", fields: [formalEntityId], references: [id], onDelete: SetNull)
  targetGroup   TargetGroup?      @relation("TargetGroupDistributions", fields: [targetGroupId], references: [id], onDelete: SetNull)
  practiceGroup PracticeGroup?    @relation("PracticeGroupDistributions", fields: [practiceGroupId], references: [id], onDelete: SetNull)
  recipientSources RecipientSource[]
  recipients    AssignmentRecipient[]

  @@index([assignmentId])
  @@index([creatorAccountId])
  @@index([organizationId])
  @@index([institutionId])
  @@index([formalEntityId])
  @@index([targetGroupId])
  @@index([practiceGroupId])
  @@map("assignment_distributions")
}

model RecipientSource {
  id            String             @id @default(cuid())
  distributionId String
  sourceType    RecipientSourceType
  sourceRefId   String?
  metadata      Json?
  createdAt     DateTime           @default(now())

  distribution AssignmentDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  @@index([distributionId])
  @@index([sourceType])
  @@map("recipient_sources")
}

model AssignmentRecipient {
  id               String          @id @default(cuid())
  distributionId   String
  recipientAccountId String
  status           RecipientStatus @default(PENDING)
  snapshotContext  Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  distribution   AssignmentDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  recipientAccount Account              @relation("RecipientAccounts", fields: [recipientAccountId], references: [id], onDelete: Cascade)
  attempt        Attempt?

  @@unique([distributionId, recipientAccountId])
  @@index([distributionId])
  @@index([recipientAccountId])
  @@map("assignment_recipients")
}

model Attempt {
  id               String        @id @default(cuid())
  recipientId      String        @unique
  learnerAccountId String
  answers          Json          @default("[]")
  status           AttemptStatus @default(DRAFT)
  submittedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  recipient    AssignmentRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  learnerAccount Account           @relation("LearnerAttempts", fields: [learnerAccountId], references: [id], onDelete: Cascade)
  helpRequests HelpRequest[]
  assessment   Assessment?

  @@index([learnerAccountId])
  @@map("attempts")
}

model HelpRequest {
  id               String            @id @default(cuid())
  attemptId        String
  learnerAccountId String
  mode             AiHelpMode
  requestContent   String
  responseContent  String?
  status           HelpRequestStatus @default(ALLOWED)
  blockReason      String?
  traceId          String
  createdAt        DateTime          @default(now())

  attempt        Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  learnerAccount Account @relation("LearnerHelpRequests", fields: [learnerAccountId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([learnerAccountId])
  @@map("help_requests")
}

model Assessment {
  id               String           @id @default(cuid())
  attemptId        String           @unique
  reviewerAccountId String
  autoCheckResult  Json?
  autoCheckStatus  AutoCheckStatus  @default(NOT_STARTED)
  aiRecommendation Json?
  confidence       String?
  warnings         Json?
  itemOverrides    Json?
  latestAiRunId    String?
  manualGrade      Float?
  maxGrade         Float?
  comment          String?
  status           AssessmentStatus @default(PENDING)
  reviewedAt       DateTime?
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  attempt         Attempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewerAccount Account          @relation("ReviewerAssessments", fields: [reviewerAccountId], references: [id], onDelete: Cascade)
  latestAiRun     AssessmentAiRun? @relation("LatestAssessmentAiRun", fields: [latestAiRunId], references: [id], onDelete: SetNull)
  aiRuns          AssessmentAiRun[] @relation("AssessmentAiRuns")

  @@index([reviewerAccountId])
  @@index([attemptId])
  @@index([autoCheckStatus])
  @@index([latestAiRunId])
  @@map("assessments")
}

model AssessmentAiRun {
  id             String                @id @default(cuid())
  assessmentId   String
  trigger        AssessmentAiRunTrigger
  status         AssessmentAiRunStatus @default(QUEUED)
  model          String
  promptVersion  String
  inputHash      String
  resultJson     Json?
  confidence     String?
  warnings       Json?
  error          String?
  tokenUsage     Json?
  traceId        String?
  queuedAt       DateTime              @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  assessment          Assessment   @relation("AssessmentAiRuns", fields: [assessmentId], references: [id], onDelete: Cascade)
  latestForAssessments Assessment[] @relation("LatestAssessmentAiRun")

  @@index([assessmentId])
  @@index([status])
  @@index([trigger])
  @@index([inputHash])
  @@map("assessment_ai_runs")
}

model StudentAnalyticsInsight {
  id               String                       @id @default(cuid())
  learnerAccountId String
  teacherAccountId String?
  subjectKey       String?
  period           String                       @default("all_time")
  metricsJson      Json?
  recommendationJson Json?
  status           StudentAnalyticsInsightStatus @default(QUEUED)
  error            String?
  generatedAt      DateTime?
  staleAt          DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  learnerAccount Account  @relation("LearnerAnalyticsInsights", fields: [learnerAccountId], references: [id], onDelete: Cascade)
  teacherAccount Account? @relation("TeacherAnalyticsInsights", fields: [teacherAccountId], references: [id], onDelete: SetNull)

  @@unique([learnerAccountId, teacherAccountId, subjectKey, period])
  @@index([learnerAccountId])
  @@index([teacherAccountId])
  @@index([subjectKey])
  @@index([status])
  @@map("student_analytics_insights")
}
